# Weaviate. docker-compose overrides WEAVIATE_HOST to "weaviate" for the
# container; keep "localhost" for running on the host.
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Who answers: ollama (default, local, no key) or anthropic. See README "Models".
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5

# When set, every request but /health must carry it in X-Proxy-Secret. Set the
# same value on the frontend (PROXY_SECRET in frontend/.env.local).
PROXY_SECRET=

# Embeddings and reranking run in-process by default ("local"). "cohere" uses
# the hosted APIs and needs COHERE_API_KEY. Changing EMBEDDING_PROVIDER
# invalidates the index: re-ingest everything.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_PROVIDER=local
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COHERE_API_KEY=

# Small-to-big chunking: the child is embedded, matched and quoted; the window
# of PARENT_WINDOW_RADIUS neighbours either side is what the model reads.
CHILD_CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=50
PARENT_WINDOW_RADIUS=1

# The agentic layer. PLANNER_ENABLED=false is the retrieval benchmark's
# baseline: one unfiltered query per collection.
PLANNER_ENABLED=true
PLANNER_MAX_SUBQUERIES=4
MIN_CANDIDATES_PER_SUBQUERY=5

# Hybrid retrieval per sub-query. HYBRID_FUSION: "relative" or "ranked" (RRF).
RETRIEVAL_CANDIDATES=60
HYBRID_ALPHA=0.5
HYBRID_FUSION=relative

# Reranking: candidates above the threshold, cut to RERANK_TOP_N (ask) or
# SEARCH_RESULTS (search).
RERANK_TOP_N=5
SEARCH_RESULTS=10
RERANK_RELEVANCE_THRESHOLD=0.35
# Optional quadratic third stage (duoT5), ~2s per query at k=5 on CPU.
PAIRWISE_RERANK_ENABLED=false

# No auth, so this bounds abuse per client.
RATE_LIMIT_QUERY=30/minute

# Langfuse tracing. Blank keys disable it; the pipeline is unchanged.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development

# Caches and resilience.
EMBEDDING_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=300
LLM_CACHE_ENABLED=true
EXTERNAL_TIMEOUT_SECONDS=60
EXTERNAL_MAX_RETRIES=3
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_RESET_SECONDS=30
INGEST_BATCH_SIZE=200
