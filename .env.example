# Weaviate
# WEAVIATE_HOST is overridden to "weaviate" by docker-compose when the app
# runs in the compose network; keep it "localhost" for running the app
# directly on the host.
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_COLLECTION=Chunk

# Cohere (embeddings + rerank)
COHERE_API_KEY=
EMBEDDING_MODEL=embed-v4.0

# Anthropic (generation)
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5

# Chunking
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=100

# Hybrid retrieval (BM25 + vector, via Weaviate's native hybrid search)
RETRIEVAL_CANDIDATES=20
HYBRID_ALPHA=0.5

# Cross-encoder reranking
RERANK_MODEL=rerank-v3.5
RERANK_TOP_N=5
RERANK_RELEVANCE_THRESHOLD=0.2

# Rate limits (no auth, so these are the abuse guard) - per X-Session-Id, or
# per IP when that header is absent. slowapi limit-string format: "N/period".
RATE_LIMIT_INGEST=20/minute
RATE_LIMIT_QUERY=30/minute

# Upload validation
MAX_UPLOAD_SIZE_MB=20

# Langfuse tracing. Leave the keys blank to run without tracing - the pipeline
# works unchanged, it just doesn't emit spans. Keys: Langfuse project settings ->
# API Keys. BASE_URL is the EU region below; US is https://us.cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Separates dev traffic from production in the Langfuse trace list.
LANGFUSE_ENVIRONMENT=development

# Malware scanning (clamd). Off by default; the service is behind a compose
# profile: docker compose --profile scanning up -d
# When enabled and clamd is unreachable, uploads are refused rather than passed.
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Caches. Embeddings are content-addressed on disk and survive restarts.
EMBEDDING_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=300
LLM_CACHE_ENABLED=true

# Resilience for provider calls
EXTERNAL_TIMEOUT_SECONDS=60
EXTERNAL_MAX_RETRIES=3
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_RESET_SECONDS=30

# Background ingestion. Bounded because the embedding provider is rate-limited.
INGEST_CONCURRENCY=2

# How BM25 and vector rankings combine: "relative" (relativeScoreFusion) or
# "ranked" (reciprocal rank fusion). Measured with eval/retrieval_benchmark.py —
# relative wins on the current corpus. Re-measure before changing.
HYBRID_FUSION=relative

# Small-to-big: the child is what gets embedded, matched, and highlighted; the
# parent window (child + radius neighbours) is what the model reads.
CHILD_CHUNK_SIZE_TOKENS=200
PARENT_WINDOW_RADIUS=1
